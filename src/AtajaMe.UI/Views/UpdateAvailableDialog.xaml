<Window x:Class="AtajaMe.UI.Views.UpdateAvailableDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nueva versión disponible"
        Icon="pack://application:,,,/AtajaMe;component/Assets/app.ico"
        Height="420" Width="520"
        MinHeight="380" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimaryBrush}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Image Source="pack://application:,,,/Assets/app.png"
                       Width="28" Height="28"
                       Margin="0,0,10,0"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="¡Nueva versión de AtajaMe disponible!"
                           FontWeight="Bold" FontSize="16"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
            </StackPanel>
            <TextBlock x:Name="VersionText"
                       Text="Versión actual: v1.0.0  ➜  Nueva versión: v1.1.0"
                       FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}"
                       Margin="38,0,0,0" />
        </StackPanel>

        <!-- Notas de la versión -->
        <GroupBox Grid.Row="1" Header="Novedades de esta versión" Margin="0,0,0,12"
                  BorderBrush="{DynamicResource BorderBrush}"
                  Foreground="{DynamicResource TextSecondaryBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="4">
                <TextBox x:Name="ReleaseNotesTextBox"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         FontSize="12" />
            </ScrollViewer>
        </GroupBox>

        <!-- Progreso de descarga -->
        <StackPanel Grid.Row="2" x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,0,0,12">
            <TextBlock x:Name="ProgressStatusText" Text="Descargando actualización..." FontSize="12" Margin="0,0,0,4" />
            <ProgressBar x:Name="DownloadProgressBar" Height="14" Minimum="0" Maximum="100" />
        </StackPanel>

        <!-- Botones de Acción -->
        <DockPanel Grid.Row="3">
            <Button Content="Ver en GitHub"
                    x:Name="ViewOnGitHubButton"
                    Click="OnViewOnGitHubClick"
                    Style="{StaticResource SecondaryButtonStyle}"
                    DockPanel.Dock="Left"
                    Padding="10,6" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Más tarde"
                        x:Name="RemindLaterButton"
                        Click="OnRemindLaterClick"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,8,0"
                        Padding="12,6" />
                <Button Content="Descargar e Instalar"
                        x:Name="DownloadInstallButton"
                        Click="OnDownloadInstallClick"
                        Style="{StaticResource AccentButtonStyle}"
                        Padding="14,6" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
