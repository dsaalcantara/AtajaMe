<Window x:Class="AtajaMe.UI.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AtajaMe.UI.ViewModels"
        mc:Ignorable="d"
        Title="AtajaMe · Configuración"
        Icon="pack://application:,,,/AtajaMe;component/Assets/app.ico"
        Height="520" Width="680"
        MinHeight="450" MinWidth="580"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimaryBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Background="Transparent" BorderBrush="{DynamicResource BorderBrush}">
            <!-- ==================== PESTAÑA: GENERAL ==================== -->
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12">
                    <StackPanel>
                        <TextBlock Text="Inicio del Sistema" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" />
                        <CheckBox Content="Iniciar AtajaMe automáticamente al encender Windows"
                                  IsChecked="{Binding StartWithWindows}"
                                  Margin="0,0,0,8" />
                        <CheckBox Content="Iniciar minimizado en la bandeja del sistema (System Tray)"
                                  IsChecked="{Binding StartMinimized}"
                                  Margin="0,0,0,16" />

                        <Separator Background="{DynamicResource BorderSubtleBrush}" Margin="0,0,0,16" />

                        <TextBlock Text="Biblioteca y Retención" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" />
                        <TextBlock Text="Límite de atajos recientes a mostrar:" FontSize="12" Margin="0,0,0,4" />
                        <TextBox Text="{Binding RecentSnippetsLimit, UpdateSourceTrigger=PropertyChanged}" Width="80" HorizontalAlignment="Left" Margin="0,0,0,12" />

                        <TextBlock Text="Días de retención en papelera antes de purga automática:" FontSize="12" Margin="0,0,0,4" />
                        <TextBox Text="{Binding TrashRetentionDays, UpdateSourceTrigger=PropertyChanged}" Width="80" HorizontalAlignment="Left" Margin="0,0,0,16" />

                        <Separator Background="{DynamicResource BorderSubtleBrush}" Margin="0,0,0,16" />

                        <TextBlock Text="Formato de Fecha y Hora por Defecto" FontWeight="Bold" FontSize="14" Margin="0,0,0,6" />
                        <TextBlock Text="Formato utilizado al expandir {fecha} o {date} sin especificar formato personalizado:"
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                        <ComboBox SelectedValue="{Binding DefaultDateFormat}"
                                  SelectedValuePath="Tag"
                                  Width="300" HorizontalAlignment="Left" Margin="0,0,0,12">
                            <ComboBoxItem Content="dd/MM/yyyy (ej. 26/09/2026)" Tag="dd/MM/yyyy" />
                            <ComboBoxItem Content="dd/MM/yy (ej. 26/09/26)" Tag="dd/MM/yy" />
                            <ComboBoxItem Content="yyyy-MM-dd (ej. 2026-09-26)" Tag="yyyy-MM-dd" />
                            <ComboBoxItem Content="d (Fecha corta de Windows)" Tag="d" />
                        </ComboBox>

                        <TextBlock Text="Formato utilizado al expandir {hora} o {time} sin especificar formato:"
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                        <ComboBox SelectedValue="{Binding DefaultTimeFormat}"
                                  SelectedValuePath="Tag"
                                  Width="300" HorizontalAlignment="Left" Margin="0,0,0,16">
                            <ComboBoxItem Content="HH:mm (ej. 16:35)" Tag="HH:mm" />
                            <ComboBoxItem Content="HH:mm:ss (ej. 16:35:00)" Tag="HH:mm:ss" />
                            <ComboBoxItem Content="t (Hora corta de Windows)" Tag="t" />
                        </ComboBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== PESTAÑA: SINCRONIZACIÓN ==================== -->
            <TabItem Header="Sincronización">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12">
                    <StackPanel>
                        <TextBlock Text="Sincronización sin Servidor Central" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" />
                        <TextBlock Text="Sincroniza tus atajos a través de una carpeta compartida en la nube (Google Drive, OneDrive o Dropbox)."
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12" TextWrapping="Wrap" />

                        <CheckBox Content="Habilitar sincronización con carpeta compartida"
                                  IsChecked="{Binding SyncEnabled}"
                                  Margin="0,0,0,12" />

                        <TextBlock Text="Ruta de la carpeta compartida:" FontSize="12" Margin="0,0,0,4" />
                        <DockPanel Margin="0,0,0,16">
                            <Button Content="Examinar..."
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    DockPanel.Dock="Right"
                                    Click="OnBrowseSyncFolderClick"
                                    Margin="8,0,0,0" />
                            <TextBox Text="{Binding SyncFolderPath, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="🔄 Sincronizar Ahora"
                                    Command="{Binding SyncNowCommand}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Margin="0,0,10,0" />
                            <Button Content="⚠️ Resolver Conflictos Pendientes"
                                    Click="OnOpenConflictResolutionClick">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource DangerButtonStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                             <DataTrigger Binding="{Binding HasPendingConflicts}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== PESTAÑA: COPIAS DE SEGURIDAD ==================== -->
            <TabItem Header="Copias de Seguridad">
                <DockPanel Margin="12">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="Copias de Seguridad Locales" FontWeight="Bold" FontSize="14" Margin="0,0,0,6" />
                        <TextBlock Text="Respaldos automáticos con la API de backup de SQLite y rotación continua."
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" />

                        <DockPanel>
                            <Button Content="+ Crear Copia Ahora"
                                    Command="{Binding CreateBackupNowCommand}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    DockPanel.Dock="Left"
                                    Margin="0,0,10,0" />
                            <Button Content="Restaurar Copia Seleccionada"
                                    Command="{Binding RestoreBackupCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    DockPanel.Dock="Left" />
                        </DockPanel>
                    </StackPanel>

                    <ListBox ItemsSource="{Binding Backups}"
                             SelectedItem="{Binding SelectedBackup}"
                             Background="{DynamicResource BgCardBrush}"
                             BorderBrush="{DynamicResource BorderBrush}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="6,4">
                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding CreatedAtUtc, StringFormat='({0:dd/MM/yyyy HH:mm:ss} UTC)'}"
                                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="8,0,0,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding SizeBytes, StringFormat='{}{0:N0} bytes'}"
                                               HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>

            <!-- ==================== PESTAÑA: APLICACIONES EXCLUIDAS ==================== -->
            <TabItem Header="Aplicaciones Excluidas">
                <DockPanel Margin="12">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="Exclusiones de Expansión" FontWeight="Bold" FontSize="14" Margin="0,0,0,6" />
                        <TextBlock Text="AtajaMe no expandirá atajos en las aplicaciones añadidas a esta lista."
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" />

                        <DockPanel>
                            <Button Content="Añadir Exclusión"
                                    Command="{Binding AddExcludedAppCommand}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    DockPanel.Dock="Right"
                                    Margin="8,0,0,0" />
                            <TextBox Text="{Binding NewExcludedProcessName, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="Ejemplo: KeePass.exe o mstsc.exe" />
                        </DockPanel>
                    </StackPanel>

                    <ListBox ItemsSource="{Binding ExcludedApps}"
                             Background="{DynamicResource BgCardBrush}"
                             BorderBrush="{DynamicResource BorderBrush}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="6,4">
                                    <Button Content="✕ Eliminar"
                                            Command="{Binding DataContext.RemoveExcludedAppCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource DangerButtonStyle}"
                                            DockPanel.Dock="Right"
                                            Padding="6,2"
                                            FontSize="11" />
                                    <TextBlock Text="{Binding ProcessName}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>

            <!-- ==================== PESTAÑA: APARIENCIA ==================== -->
            <TabItem Header="Apariencia">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12">
                    <StackPanel>
                        <TextBlock Text="Tema Visual" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" />
                        <TextBlock Text="Selecciona el tema de la aplicación o permite que se adapte al sistema operativo."
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12" />

                        <ComboBox SelectedValue="{Binding Theme}"
                                  SelectedValuePath="Tag"
                                  Width="220"
                                  HorizontalAlignment="Left"
                                  Margin="0,0,0,16">
                            <ComboBoxItem Content="Automático (Según Windows)" Tag="System" />
                            <ComboBoxItem Content="Tema Claro (Light)" Tag="Light" />
                            <ComboBoxItem Content="Tema Oscuro (Dark)" Tag="Dark" />
                        </ComboBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== PESTAÑA: ACERCA DE ==================== -->
            <TabItem Header="Acerca de y Privacidad">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                            <Image Source="pack://application:,,,/Assets/app.png"
                                   Width="22" Height="22"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="AtajaMe · Versión 1.0 (MVP)" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="Gestor de atajos y expansión de texto instantáneo para Windows."
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16" />

                        <TextBlock Text="🔒 Privacidad Estricta" FontWeight="Bold" FontSize="13" Margin="0,0,0,4" />
                        <TextBlock Text="• El búfer de teclado es circular y 100% efímero en memoria (máx. 50 caracteres).&#x0a;• Se purga automáticamente tras 5 segundos de inactividad, cambio de foco o pérdida de coincidencia.&#x0a;• Cero pulsaciones tecleadas ni textos expandidos se guardan en disco ni logs.&#x0a;• Los campos de contraseña son detectados por UI Automation cancelando la captura de inmediato.&#x0a;• Cero telemetría: tus atajos y datos nunca salen de tu ordenador salvo la carpeta que tú configures."
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,16" />

                        <TextBlock Text="💡 Cómo provocar expansiones" FontWeight="Bold" FontSize="13" Margin="0,0,0,4" />
                        <TextBlock Text="Escribe el código configurado para el atajo en cualquier aplicación compatible y añade un delimitador (Espacio o Tabulador). AtajaMe reemplazará el código inmediatamente."
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,16" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Pie de diálogo con acciones -->
        <DockPanel Grid.Row="1" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="400" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cerrar"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="OnCloseButtonClick"
                        Margin="0,0,8,0"
                        Padding="12,6" />
                <Button Content="Guardar Ajustes"
                        Command="{Binding SaveSettingsCommand}"
                        Style="{StaticResource AccentButtonStyle}"
                        Padding="14,6" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
