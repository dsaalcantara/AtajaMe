<Window x:Class="AtajaMe.UI.Views.CsvImportPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AtajaMe.UI.ViewModels"
        xmlns:enums="clr-namespace:AtajaMe.Domain.Enums;assembly=AtajaMe.Domain"
        mc:Ignorable="d"
        Title="AtajaMe · Vista Previa de Importación CSV"
        Height="480" Width="640"
        MinHeight="400" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimaryBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="📥 Vista Previa de Importación CSV (RF-26)"
                       FontWeight="Bold"
                       FontSize="16" />
            <DockPanel Margin="0,6,0,0">
                <TextBlock Text="{Binding TotalRows, StringFormat='Total filas: {0}'}" Margin="0,0,16,0" FontSize="12" />
                <TextBlock Text="{Binding ValidSnippetsCount, StringFormat='Atajos válidos: {0}'}" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" Margin="0,0,16,0" FontSize="12" />
                <TextBlock Text="{Binding CollisionsCount, StringFormat='Colisiones: {0}'}" Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold" Margin="0,0,16,0" FontSize="12" />
                <TextBlock Text="{Binding ErrorsCount, StringFormat='Errores: {0}'}" Foreground="{DynamicResource DangerBrush}" FontSize="12" />
            </DockPanel>
        </StackPanel>

        <!-- Contenido Central: Colisiones -->
        <Border Grid.Row="1"
                Background="{DynamicResource BgCardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10">
            <DockPanel>
                <TextBlock Text="Resolución de códigos existentes:"
                           FontWeight="SemiBold"
                           FontSize="13"
                           DockPanel.Dock="Top"
                           Margin="0,0,0,8" />

                <ListBox ItemsSource="{Binding Collisions}"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CsvCollisionItemViewModel}">
                            <DockPanel Margin="0,4">
                                <Border Style="{StaticResource CodeBadgeStyle}" DockPanel.Dock="Left" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding Code}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                                <ComboBox SelectedValue="{Binding Resolution}"
                                          DockPanel.Dock="Right"
                                          Width="150"
                                          Margin="8,0,0,0">
                                    <ComboBoxItem Content="Omitir" Tag="{x:Static enums:CsvConflictResolution.Skip}" />
                                    <ComboBoxItem Content="Sobrescribir" Tag="{x:Static enums:CsvConflictResolution.Overwrite}" />
                                    <ComboBoxItem Content="Duplicar con sufijo" Tag="{x:Static enums:CsvConflictResolution.DuplicateWithSuffix}" />
                                </ComboBox>
                                <TextBlock Text="{Binding IncomingName, StringFormat='Importando: {0}'}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Acciones Inferiores -->
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,8,0"
                        Padding="12,6" />
                <Button Content="Proceder con la Importación"
                        Command="{Binding ConfirmCommand}"
                        Style="{StaticResource AccentButtonStyle}"
                        Padding="14,6" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
