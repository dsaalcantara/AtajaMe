<Window x:Class="AtajaMe.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AtajaMe.UI.ViewModels"
        mc:Ignorable="d"
        Title="AtajaMe · Gestor de Atajos de Teclado"
        Icon="pack://application:,,,/AtajaMe;component/Assets/app.ico"
        Height="700" Width="1100"
        MinHeight="550" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgPrimaryBrush}">

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="N" Command="{Binding NewSnippetCommand}" />
        <KeyBinding Modifiers="Control" Key="S" Command="{Binding Editor.SaveCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteSnippetCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="180" MaxWidth="420" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="340" MinWidth="240" MaxWidth="500" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- ============================================== -->
            <!-- PANEL LATERAL IZQUIERDO (NAVEGACIÓN Y CARPETAS) -->
            <!-- ============================================== -->
            <Border Grid.Column="0"
                    Background="{DynamicResource BgSidebarBrush}">
                <DockPanel Margin="12,16,12,12">
                    <!-- Logotipo y Estado Superior -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Width="22" Height="22"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Source>
                                        <BitmapImage UriSource="pack://application:,,,/Assets/app.png" DecodePixelWidth="44" />
                                    </Image.Source>
                                </Image>
                                <TextBlock Text="AtajaMe"
                                           FontWeight="Bold"
                                           FontSize="17"
                                           Foreground="{DynamicResource AccentBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Border HorizontalAlignment="Right"
                                    CornerRadius="10"
                                    Padding="8,2"
                                    VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOrchestratorPaused}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="White">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="ACTIVO" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOrchestratorPaused}" Value="True">
                                                    <Setter Property="Text" Value="EN PAUSA" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </DockPanel>
                        <TextBlock Text="Atajos de texto instantáneos"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- Acciones y Configuración al pie del sidebar -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Content="📥 Importar..."
                                    Command="{Binding ImportCsvCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="4,4"
                                    FontSize="11"
                                    ToolTip="Importar atajos desde un archivo CSV (ej. PhraseExpress)" />
                            <Button Grid.Column="2"
                                    Content="📤 Exportar..."
                                    Command="{Binding ExportCsvCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="4,4"
                                    FontSize="11"
                                    ToolTip="Exportar biblioteca activa a formato CSV" />
                        </Grid>
                        <Button Content="⚙ Configuración..."
                                Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Click="OnSettingsButtonClick"
                                Padding="8,4" />
                    </StackPanel>

                    <!-- Menú de Biblioteca Fijo arriba -->
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="BIBLIOTECA"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="4,0,0,6" />

                        <!-- Todos -->
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding SelectAllCommand}"
                                HorizontalContentAlignment="Stretch"
                                BorderThickness="0"
                                Margin="0,1">
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="{Binding AllCount, StringFormat='({0})'}"
                                           DockPanel.Dock="Right"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0" />
                                <TextBlock Text="📋 Todos los atajos" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </Button>

                        <!-- Favoritos -->
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding SelectFavoritesCommand}"
                                HorizontalContentAlignment="Stretch"
                                BorderThickness="0"
                                Margin="0,1">
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="{Binding FavoritesCount, StringFormat='({0})'}"
                                           DockPanel.Dock="Right"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0" />
                                <TextBlock Text="⭐ Favoritos" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </Button>

                        <!-- Recientes -->
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding SelectRecentCommand}"
                                HorizontalContentAlignment="Stretch"
                                BorderThickness="0"
                                Margin="0,1">
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="{Binding RecentCount, StringFormat='({0})'}"
                                           DockPanel.Dock="Right"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0" />
                                <TextBlock Text="🕒 Recientes" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </Button>

                        <!-- Papelera -->
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding SelectTrashCommand}"
                                HorizontalContentAlignment="Stretch"
                                BorderThickness="0"
                                Margin="0,1">
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="{Binding TrashCount, StringFormat='({0})'}"
                                           DockPanel.Dock="Right"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0" />
                                <TextBlock Text="🗑 Papelera" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </Button>

                        <Separator Background="{DynamicResource BorderBrush}" Margin="0,12" />

                        <!-- Sección Carpetas (Cabecera fija) -->
                        <DockPanel Margin="4,0,0,6">
                            <Button Content="+"
                                    Command="{Binding NewFolderCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    DockPanel.Dock="Right"
                                    Padding="6,1"
                                    ToolTip="Nueva carpeta raíz" />
                            <TextBlock Text="CARPETAS"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>

                    <!-- Árbol de Carpetas con su propio ScrollViewer independiente (Vertical y Horizontal) -->
                    <TreeView ItemsSource="{Binding FolderTree}"
                              Background="Transparent"
                              BorderThickness="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              SelectedItemChanged="OnFolderTreeSelectedItemChanged"
                              KeyDown="OnFolderTreeKeyDown">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TreeView}}" />
                                <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnTreeViewItemPreviewMouseRightButtonDown" />
                                <EventSetter Event="RequestBringIntoView" Handler="OnTreeViewItemRequestBringIntoView" />
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <ContextMenu>
                                            <MenuItem Header="➕ Nueva subcarpeta..."
                                                      Command="{Binding PlacementTarget.Tag.NewSubFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="✏️ Renombrar carpeta..."
                                                      Command="{Binding PlacementTarget.Tag.RenameFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <Separator />
                                            <MenuItem Header="🗑️ Eliminar carpeta"
                                                      Command="{Binding PlacementTarget.Tag.DeleteFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        </ContextMenu>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type vm:FolderTreeItemViewModel}"
                                                      ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="2,3" ToolTip="{Binding Name}">
                                    <TextBlock Text="📁 "
                                               FontSize="12"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               VerticalAlignment="Center"
                                               Margin="2,0,6,0" />
                                    <TextBlock Text="{Binding SnippetCount, StringFormat='({0})'}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>

            <!-- Separador Vertical Redimensionable entre Sidebar y Lista -->
            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          Background="{DynamicResource BorderBrush}"
                          Cursor="SizeWE" />

            <!-- ============================================== -->
            <!-- PANEL CENTRAL (LISTA DE ATAJOS Y BÚSQUEDA)      -->
            <!-- ============================================== -->
            <Grid Grid.Column="2" Background="{DynamicResource BgSecondaryBrush}">
                <DockPanel Margin="12,16,12,12">
                    <!-- Cabecera Superior: Título a la izquierda, Nuevo Atajo a la derecha -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <!-- Botón Vaciar Papelera si está en papelera -->
                            <Button Content="Vaciar Papelera"
                                    Command="{Binding PurgeTrashCommand}"
                                    Margin="0,0,6,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource DangerButtonStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTrashSelected}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Content="+ Nuevo Atajo"
                                    Command="{Binding NewSnippetCommand}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    ToolTip="Crear un nuevo atajo (Ctrl+N)" />
                        </StackPanel>
                        
                        <TextBlock Text="{Binding CurrentSectionTitle}"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>

                    <!-- Barra de herramientas de Carpeta (solo visible al seleccionar una carpeta, responsiva con WrapPanel) -->
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <WrapPanel.Style>
                            <Style TargetType="WrapPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFolderSelected}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </WrapPanel.Style>

                        <Button Content="✏️ Renombrar"
                                Command="{Binding RenameFolderCommand}"
                                CommandParameter="{Binding SelectedFolder}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="8,3"
                                FontSize="11"
                                Margin="0,0,6,4"
                                ToolTip="Renombrar esta carpeta (F2)" />

                        <Button Content="➕ Subcarpeta"
                                Command="{Binding NewSubFolderCommand}"
                                CommandParameter="{Binding SelectedFolder}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="8,3"
                                FontSize="11"
                                Margin="0,0,6,4"
                                ToolTip="Crear una subcarpeta dentro de esta carpeta" />

                        <Button Content="🗑️ Eliminar"
                                Command="{Binding DeleteFolderCommand}"
                                CommandParameter="{Binding SelectedFolder}"
                                Style="{StaticResource DangerButtonStyle}"
                                Padding="8,3"
                                FontSize="11"
                                Margin="0,0,0,4"
                                ToolTip="Eliminar esta carpeta (Supr)" />
                    </WrapPanel>

                    <!-- Buscador en tiempo real (RF-15) -->
                    <Border DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Buscar por código, nombre o contenido...">
                            <!-- Placeholder visual -->
                        </TextBox>
                    </Border>

                    <!-- Lista de Atajos -->
                    <ListBox ItemsSource="{Binding DisplayedSnippets}"
                             SelectedItem="{Binding SelectedSnippet}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,4" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="border"
                                                    Background="{DynamicResource BgCardBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="10,8">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource BgSelectedBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SnippetItemViewModel}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <DockPanel>
                                            <!-- Badge del código -->
                                            <Border Style="{StaticResource CodeBadgeStyle}"
                                                    Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Code}"
                                                           FontFamily="Cascadia Code, Consolas, Courier New"
                                                           FontWeight="Bold"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource AccentBrush}" />
                                            </Border>
                                            <!-- Nombre -->
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       FontSize="13"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DockPanel>

                                        <!-- Vista previa del contenido -->
                                        <TextBlock Text="{Binding ContentPreview}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="12"
                                                   Margin="0,4,0,0"
                                                   TextTrimming="CharacterEllipsis" />

                                        <!-- Metadatos de carpeta -->
                                        <TextBlock Text="{Binding FolderName, StringFormat='📁 {0}'}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Margin="0,4,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding FolderName}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Acciones en Item: Favorito y Estado, o Restaurar si está en papelera -->
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="6,0,0,0">
                                        <!-- Botón Restaurar si está en la papelera -->
                                        <Button Command="{Binding DataContext.RestoreSnippetCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                Padding="8,3"
                                                FontSize="11"
                                                ToolTip="Restaurar este atajo de la papelera"
                                                Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsInTrash}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock Text="♻️ Restaurar" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </Button>

                                        <!-- Botón Favorito (solo si no está en papelera) -->
                                        <Button Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Margin="0,0,4,0">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsInTrash}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock FontSize="14">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="☆" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                <Setter Property="Text" Value="⭐" />
                                                                <Setter Property="Foreground" Value="#F59E0B" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button>

                                        <!-- Checkbox Activo (solo si no está en papelera) -->
                                        <CheckBox IsChecked="{Binding IsActive}"
                                                  Command="{Binding DataContext.ToggleActiveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                  CommandParameter="{Binding}"
                                                  ToolTip="Activar o desactivar este atajo"
                                                  VerticalAlignment="Center">
                                            <CheckBox.Style>
                                                <Style TargetType="CheckBox">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsInTrash}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </CheckBox.Style>
                                        </CheckBox>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Grid>

            <!-- Separador Vertical Redimensionable -->
            <GridSplitter Grid.Column="3"
                          Width="4"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          Background="{DynamicResource BorderBrush}"
                          Cursor="SizeWE" />

            <!-- ============================================== -->
            <!-- PANEL DERECHO (INSPECTOR Y EDITOR DE ATAJO)     -->
            <!-- ============================================== -->
            <Grid Grid.Column="4" Background="{DynamicResource BgPrimaryBrush}">
                <!-- Estado Vacío (si no hay atajo en edición) -->
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Editor.IsVisible}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>

                    <Grid VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="20,16">
                        <StackPanel HorizontalAlignment="Center" MaxWidth="320">
                            <TextBlock Text="⚡" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,12" />
                            <TextBlock Text="Ningún atajo seleccionado"
                                       FontWeight="Bold"
                                       FontSize="16"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,0,0,8" />
                            <TextBlock Text="Selecciona un atajo de la lista para editarlo o pulsa Ctrl+N para crear uno nuevo."
                                       FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- Panel Editor Activo -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Editor.IsVisible}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>

                    <StackPanel Margin="20,16">
                        <!-- Título de Edición -->
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock FontWeight="Bold" FontSize="16" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        <Setter Property="Text" Value="Editar Atajo" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Editor.IsNew}" Value="True">
                                                <Setter Property="Text" Value="Nuevo Atajo" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DockPanel>

                        <!-- Banner Informativo si el atajo está en la Papelera -->
                        <Border Background="#FEF3C7"
                                BorderBrush="#F59E0B"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,10"
                                Margin="0,0,0,12">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Editor.IsInTrash}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel>
                                <Button Content="♻️ Restaurar Atajo"
                                        Command="{Binding RestoreSnippetCommand}"
                                        CommandParameter="{Binding Editor}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        DockPanel.Dock="Right"
                                        Padding="12,4"
                                        FontWeight="SemiBold"
                                        ToolTip="Recuperar este atajo y devolverlo a la biblioteca activa" />
                                <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="🗑️ Este atajo está en la Papelera"
                                               FontWeight="Bold"
                                               Foreground="#92400E"
                                               FontSize="13" />
                                    <TextBlock Text="Pulsa 'Restaurar Atajo' para reactivarlo y poder volver a editarlo o usarlo."
                                               Foreground="#B45309"
                                               FontSize="11"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Mensaje de Error de Validación -->
                        <Border Background="#FEE2E2"
                                BorderBrush="{DynamicResource DangerBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,6"
                                Margin="0,0,0,12">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Editor.HasError}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding Editor.ErrorMessage}"
                                       Foreground="{DynamicResource DangerBrush}"
                                       FontWeight="SemiBold"
                                       FontSize="12" />
                        </Border>

                        <!-- Campo: Código de Disparo (RF-02) -->
                        <TextBlock Text="Código de activación (disparador):"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,4" />
                        <TextBox Text="{Binding Editor.Code, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Cascadia Code, Consolas, Courier New"
                                 FontWeight="Bold"
                                 Margin="0,0,0,12" />

                        <!-- Campo: Nombre Descriptivo -->
                        <TextBlock Text="Nombre del atajo:"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,4" />
                        <TextBox Text="{Binding Editor.Name, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,12" />

                        <!-- Campo: Carpeta -->
                        <TextBlock Text="Carpeta contenedora:"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding Editor.AvailableFolders}"
                                  SelectedValue="{Binding Editor.SelectedFolderId}"
                                  SelectedValuePath="Id"
                                  DisplayMemberPath="DisplayName"
                                  Margin="0,0,0,12" />

                        <!-- Opciones y Conmutadores -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <CheckBox Content="Sensible a mayúsculas"
                                      IsChecked="{Binding Editor.CaseSensitive}"
                                      Margin="0,0,16,0" />
                            <CheckBox Content="Atajo activo"
                                      IsChecked="{Binding Editor.IsActive}"
                                      Margin="0,0,16,0" />
                            <CheckBox Content="Favorito"
                                      IsChecked="{Binding Editor.IsFavorite}" />
                        </StackPanel>

                        <!-- Barra de Herramientas de Inserción de Variables -->
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Contenido del atajo (texto a expandir):"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Editor.ContentLengthInfo}"
                                       HorizontalAlignment="Right"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center" />
                        </DockPanel>

                        <!-- Botones de inserción de variables -->
                        <WrapPanel Margin="0,0,0,6">
                            <Button Content="+ Fecha"
                                    ToolTip="Fecha actual con formato de configuración ({fecha})"
                                    Command="{Binding Editor.InsertVariableCommand}"
                                    CommandParameter="{}{fecha}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,0,4,4" Padding="6,2" FontSize="11" />
                            <Button Content="+ Hora"
                                    ToolTip="Hora actual en formato 24h ({hora})"
                                    Command="{Binding Editor.InsertVariableCommand}"
                                    CommandParameter="{}{hora}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,0,4,4" Padding="6,2" FontSize="11" />
                            <Button Content="+ Mes"
                                    ToolTip="Número de mes de dos dígitos ({mes})"
                                    Command="{Binding Editor.InsertVariableCommand}"
                                    CommandParameter="{}{mes}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,0,4,4" Padding="6,2" FontSize="11" />
                            <Button Content="+ Día"
                                    ToolTip="Número de día de dos dígitos ({dia})"
                                    Command="{Binding Editor.InsertVariableCommand}"
                                    CommandParameter="{}{dia}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,0,4,4" Padding="6,2" FontSize="11" />
                            <Button Content="+ Variable"
                                    ToolTip="Variable que solicita un texto interactivo al expandir ({input:nombre})"
                                    Command="{Binding Editor.InsertVariableCommand}"
                                    CommandParameter="{}{input:nombre}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,0,4,4" Padding="6,2" FontSize="11" />
                            <Button Content="➕ Más marcadores ▾"
                                    Click="OnInsertVariableButtonClick"
                                    ToolTip="Despliega el catálogo completo de marcadores de fecha, días, semanas, trimestres y cuatrimestres"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,0,4,4" Padding="8,2" FontSize="11" FontWeight="SemiBold">
                                <Button.ContextMenu>
                                    <ContextMenu DataContext="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="📅 Fechas">
                                            <MenuItem Header="{}{fecha} (Predeterminada)" Command="{Binding Editor.InsertVariableCommand}" CommandParameter="{}{fecha}" />
                                            <MenuItem Header="{}{fecha:dd/mm/aaaa} (dd/mm/aaaa)" Command="{Binding Editor.InsertVariableCommand}" CommandParameter="{}{fecha:dd/mm/aaaa}" />
                                            <MenuItem Header="{}{fecha:aaaa-mm-dd} (ISO aaaa-mm-dd)" Command="{Binding Editor.InsertVariableCommand}" CommandParameter="{}{fecha:aaaa-mm-dd}" />
                                            <MenuItem Header="{}{fecha:dd/mm/aa} (dd/mm/aa)" Command="{Binding Editor.InsertVariableCommand}" CommandParameter="{}{fecha:dd/mm/aa}" />
                                            <MenuItem Header="{}{fecha:aammdd} (aammdd compacto)" Command="{Binding Editor.InsertVariableCommand}" CommandParameter="{}{fecha:aammdd}" />
                                        </MenuItem>
                                        <MenuItem Header="🕒 Horas">
                                            <MenuItem Header="{}{hora} (Hora 24h)" Command="{Binding Editor.InsertVariableCommand}" CommandParameter="{}{hora}" />
                                            <MenuItem Header="{}{hora:HH:mm:ss} (Con segundos)" Command="{Binding Editor.InsertVariableCommand}" CommandParameter="{}{hora:HH:mm:ss}" />
                                            <MenuItem Header="{}{fechahora} (Fecha y hora combinada)" Command="{Binding Editor.InsertVariableCommand}" CommandParameter="{}{fechahora}" />
                                        </MenuItem>
                                        <MenuItem Header="🗓️ Días">
                                            <MenuItem Header="{}{dia} (Número 01..31)" Command="{Binding Editor.InsertVariableCommand}" CommandParameter="{}{dia}" />
                                            <MenuItem Header="{}{dia:Nombre} (Nombre capitalizado, ej. Lunes)" Command="{Binding Editor.InsertVariableCommand}" CommandParameter="{}{dia:Nombre}" />
                                            <MenuItem Header="{}{dia:nombre} (Nombre minúsculas, ej. lunes)" Command="{Binding Editor.InsertVariableCommand}" CommandParameter="{}{dia:nombre}" />
                                            <MenuItem Header="{}{dia:MAYUS} (Nombre mayúsculas, ej. LUNES)" Command="{Binding Editor.InsertVariableCommand}" CommandParameter="{}{dia:MAYUS}" />
                                            <MenuItem Header="{}{dia:corto} (Abreviado, ej. Lun)" Command="{Binding Editor.InsertVariableCommand}" CommandParameter="{}{dia:corto}" />
                                            <Separator />
                                            <MenuItem Header="{}{dia:+1} (Mañana, número)" Command="{Binding Editor.InsertVariableCommand}" CommandParameter="{}{dia:+1}" />
                                            <MenuItem Header="{}{dia:+1:Nombre} (Mañana, nombre)" Command="{Binding Editor.InsertVariableCommand}" CommandParameter="{}{dia:+1:Nombre}" />
                                            <MenuItem Header="{}{dia:-1} (Ayer, número)" Command="{Binding Editor.InsertVariableCommand}" CommandParameter="{}{dia:-1}" />
                                            <MenuItem Header="{}{dia:año} (Día del año 1..366)" Command="{Binding Editor.InsertVariableCommand}" CommandParameter="{}{dia:año}" />
                                        </MenuItem>
                                        <MenuItem Header="📆 Meses">
                                            <MenuItem Header="{}{mes} (Número 01..12)" Command="{Binding Editor.InsertVariableCommand}" CommandParameter="{}{mes}" />
                                            <MenuItem Header="{}{mes:Nombre} (Nombre capitalizado, ej. Septiembre)" Command="{Binding Editor.InsertVariableCommand}" CommandParameter="{}{mes:Nombre}" />
                                            <MenuItem Header="{}{mes:nombre} (Nombre minúsculas, ej. septiembre)" Command="{Binding Editor.InsertVariableCommand}" CommandParameter="{}{mes:nombre}" />
                                            <MenuItem Header="{}{mes:MAYUS} (Nombre mayúsculas, ej. SEPTIEMBRE)" Command="{Binding Editor.InsertVariableCommand}" CommandParameter="{}{mes:MAYUS}" />
                                            <MenuItem Header="{}{mes:corto} (Abreviado, ej. Sep)" Command="{Binding Editor.InsertVariableCommand}" CommandParameter="{}{mes:corto}" />
                                            <Separator />
                                            <MenuItem Header="{}{mes:+1} (Próximo mes, número)" Command="{Binding Editor.InsertVariableCommand}" CommandParameter="{}{mes:+1}" />
                                            <MenuItem Header="{}{mes:+1:Nombre} (Próximo mes, nombre)" Command="{Binding Editor.InsertVariableCommand}" CommandParameter="{}{mes:+1:Nombre}" />
                                            <MenuItem Header="{}{mes:-1} (Mes anterior, número)" Command="{Binding Editor.InsertVariableCommand}" CommandParameter="{}{mes:-1}" />
                                            <MenuItem Header="{}{mes:-1:Nombre} (Mes anterior, nombre)" Command="{Binding Editor.InsertVariableCommand}" CommandParameter="{}{mes:-1:Nombre}" />
                                        </MenuItem>
                                        <MenuItem Header="📅 Semanas">
                                            <MenuItem Header="{}{semana} (Semana ISO actual, ej. 39)" Command="{Binding Editor.InsertVariableCommand}" CommandParameter="{}{semana}" />
                                            <MenuItem Header="CW {}{semana} (ej. CW 39)" Command="{Binding Editor.InsertVariableCommand}" CommandParameter="CW {semana}" />
                                            <MenuItem Header="CW {}{semana:+1} (Próxima semana, ej. CW 40)" Command="{Binding Editor.InsertVariableCommand}" CommandParameter="CW {semana:+1}" />
                                            <MenuItem Header="CW {}{semana:-1} (Semana pasada, ej. CW 38)" Command="{Binding Editor.InsertVariableCommand}" CommandParameter="CW {semana:-1}" />
                                        </MenuItem>
                                        <MenuItem Header="📊 Trimestres y Cuatrimestres">
                                            <MenuItem Header="{}{trimestre} (ej. T3)" Command="{Binding Editor.InsertVariableCommand}" CommandParameter="{}{trimestre}" />
                                            <MenuItem Header="{}{trimestre:Q} (ej. Q3)" Command="{Binding Editor.InsertVariableCommand}" CommandParameter="{}{trimestre:Q}" />
                                            <MenuItem Header="{}{trimestre:num} (Dígito 1..4)" Command="{Binding Editor.InsertVariableCommand}" CommandParameter="{}{trimestre:num}" />
                                            <MenuItem Header="{}{trimestre:romano} (Romano I..IV)" Command="{Binding Editor.InsertVariableCommand}" CommandParameter="{}{trimestre:romano}" />
                                            <MenuItem Header="{}{trimestre:+1} (Próximo trimestre)" Command="{Binding Editor.InsertVariableCommand}" CommandParameter="{}{trimestre:+1}" />
                                            <Separator />
                                            <MenuItem Header="{}{cuatrimestre} (ej. C3)" Command="{Binding Editor.InsertVariableCommand}" CommandParameter="{}{cuatrimestre}" />
                                            <MenuItem Header="{}{cuatrimestre:num} (Dígito 1..3)" Command="{Binding Editor.InsertVariableCommand}" CommandParameter="{}{cuatrimestre:num}" />
                                            <MenuItem Header="{}{cuatrimestre:romano} (Romano I..III)" Command="{Binding Editor.InsertVariableCommand}" CommandParameter="{}{cuatrimestre:romano}" />
                                            <MenuItem Header="{}{cuatrimestre:+1} (Próximo cuatrimestre)" Command="{Binding Editor.InsertVariableCommand}" CommandParameter="{}{cuatrimestre:+1}" />
                                        </MenuItem>
                                        <MenuItem Header="⏳ Años">
                                            <MenuItem Header="{}{año} (Año 4 dígitos, ej. 2026)" Command="{Binding Editor.InsertVariableCommand}" CommandParameter="{}{año}" />
                                            <MenuItem Header="{}{año:corto} (Año 2 dígitos, ej. 26)" Command="{Binding Editor.InsertVariableCommand}" CommandParameter="{}{año:corto}" />
                                            <MenuItem Header="{}{año:+1} (Próximo año)" Command="{Binding Editor.InsertVariableCommand}" CommandParameter="{}{año:+1}" />
                                            <MenuItem Header="{}{año:-1} (Año anterior)" Command="{Binding Editor.InsertVariableCommand}" CommandParameter="{}{año:-1}" />
                                        </MenuItem>
                                        <MenuItem Header="🔀 Condicionales">
                                            <MenuItem Header="Saludo según hora (Días / Tardes / Noches)"
                                                      Command="{Binding Editor.InsertVariableCommand}"
                                                      CommandParameter="{}{si hora &lt; 12}&#x0a;Buenos días&#x0a;{sino si hora &lt; 20}&#x0a;Buenas tardes&#x0a;{sino}&#x0a;Buenas noches&#x0a;{/si}" />
                                            <MenuItem Header="Bloque simple: {si condición}...{/si}"
                                                      Command="{Binding Editor.InsertVariableCommand}"
                                                      CommandParameter="{}{si hora &lt; 12}&#x0a;Buenos días&#x0a;{/si}" />
                                            <MenuItem Header="Bloque con alternativa: {si}...{sino}...{/si}"
                                                      Command="{Binding Editor.InsertVariableCommand}"
                                                      CommandParameter="{}{si dia_semana &lt;= 5}&#x0a;Laborable&#x0a;{sino}&#x0a;Fin de semana&#x0a;{/si}" />
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="⚙️ Interactivas y Especiales">
                                            <MenuItem Header="{}{input:nombre} (Variable interactiva)" Command="{Binding Editor.InsertVariableCommand}" CommandParameter="{}{input:nombre}" />
                                            <MenuItem Header="{}{clipboard} (Portapapeles)" Command="{Binding Editor.InsertVariableCommand}" CommandParameter="{}{clipboard}" />
                                            <MenuItem Header="{}{cursor} (Posicionamiento de cursor)" Command="{Binding Editor.InsertVariableCommand}" CommandParameter="{}{cursor}" />
                                        </MenuItem>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </WrapPanel>

                        <!-- Campo de Contenido Multilínea -->
                        <TextBox Text="{Binding Editor.Content, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 MinHeight="140"
                                 MaxHeight="260"
                                 FontFamily="Cascadia Code, Consolas, Courier New"
                                 FontSize="12"
                                 Margin="0,0,0,16" />

                        <!-- Acciones Guardar / Descartar -->
                        <DockPanel Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <Button Content="Descartar"
                                        Command="{Binding Editor.CancelCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="0,0,8,0"
                                        Padding="12,6" />
                                <Button Content="Guardar Atajo (Ctrl+S)"
                                        Command="{Binding Editor.SaveCommand}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Padding="14,6" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="♻️ Restaurar Atajo"
                                        Command="{Binding RestoreSnippetCommand}"
                                        CommandParameter="{Binding Editor}"
                                        Margin="0,0,8,0"
                                        Padding="12,5"
                                        ToolTip="Restaurar este atajo de la papelera">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Editor.IsInTrash}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Content="Duplicar"
                                        Command="{Binding DuplicateSnippetCommand}"
                                        Margin="0,0,8,0"
                                        Padding="10,5">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Editor.IsInTrash}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Content="Eliminar"
                                        Command="{Binding DeleteSnippetCommand}"
                                        Padding="10,5">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource DangerButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Editor.IsInTrash}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </DockPanel>

                        <!-- Estadísticas de Uso (RF-17) -->
                        <Border Background="{DynamicResource BgCardBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,8">
                            <DockPanel>
                                <TextBlock Text="{Binding Editor.UsageCount, StringFormat='Veces utilizado: {0}'}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding Editor.LastUsedAt, StringFormat='Último uso: {0:dd/MM/yyyy HH:mm}', TargetNullValue='Último uso: Nunca'}"
                                           HorizontalAlignment="Right"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ============================================== -->
        <!-- BARRA DE ESTADO INFERIOR                        -->
        <!-- ============================================== -->
        <Border Grid.Row="1"
                Background="{DynamicResource BgSidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,6">
            <DockPanel>
                <Button Command="{Binding TogglePauseOrchestratorCommand}"
                        DockPanel.Dock="Right"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="8,2"
                        FontSize="11">
                    <Button.Content>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="⏸ Pausar motor" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOrchestratorPaused}" Value="True">
                                            <Setter Property="Text" Value="▶ Reanudar motor" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button.Content>
                </Button>

                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
